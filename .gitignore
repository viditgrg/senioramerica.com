
# ==========================================
# Drupal 11 - Git Ignore
# ==========================================

# Dependencies
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Composer
/composer.lock.bak

# Drupal configuration
/web/sites/*/settings.php
/web/sites/*/settings.*.php
/web/sites/*/services.yml
/web/sites/*/services.*.yml

# Drupal files and uploaded assets
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/private-files/

# Keep default files directory structure
!/web/sites/default/files/.gitkeep

# Drupal temporary files
/tmp/
/temp/

# Drupal generated files
/web/sites/*/files/css/
/web/sites/*/files/js/
/web/sites/*/files/php/

# IDE and editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
composer-error.log

# Environment files
.env
.env.*
!.env.example

# Node.js dependencies and builds
/node_modules/
/npm-debug.log*
/yarn-error.log*

# PHP tools and caches
.phpunit.cache/
/.phpunit.result.cache
.phpstan/
/phpstan.neon.tmp
.php-cs-fixer.cache
/.phpunit-watcher.yml

# PHPUnit
/coverage/
/build/

# Drupal development tools
/drush/sites/
/drush/cache/

# DDEV
/.ddev/.global_commands/

# Lando
/.lando/

# Backup files
*.bak
*.old
*.orig
*.save
*.backup
*.sql
*.sql.gz

# Archives
*.zip
*.tar
*.tar.gz

# Local development configuration
/web/sites/default/default.settings.php
